# Copy this file to .env and fill it in. .env is git-ignored, never commit it.

# Supabase: Project Settings, then API Keys.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Cloudflare Pages project used by `npm run deploy`.
CF_PAGES_PROJECT=planning-poker

# Optional: where your brand pack lives (default ./brand). See brand.example/.
# BRAND_DIR=./brand
